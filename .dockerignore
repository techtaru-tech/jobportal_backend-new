# Keep the build context small and the image reproducible.
#
# vendor/ and node_modules/ are excluded on purpose: they are installed inside
# the image from the lockfiles. Copying a host-built vendor/ would ship
# Windows-resolved platform packages into a Linux image.
vendor/
node_modules/
public/build/
public/hot
public/storage

# Secrets and per-machine state. .env.example and .env.docker are templates and
# are NOT excluded — the entrypoint copies one when no .env is mounted.
.env
.env.*.local
.env.backup
.env.production

storage/*.key
storage/app/private/*
storage/app/public/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/logs/*
!storage/**/.gitignore

.git/
.gitignore
.gitattributes
.github/
.idea/
.vscode/
.fleet/
.nova/
.zed/
.phpunit.result.cache
.phpunit.cache/

# Host-only helpers — the container has its own entrypoint.
start-server.bat

# Docs are not needed at runtime.
*.md
!README.md

Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
