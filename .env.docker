# Environment for the docker-compose stack.
#
# Committed on purpose — these are local-stack defaults, not secrets. Anything
# real (APP_KEY, database passwords, an SMS gateway credential) belongs in a
# .env.docker.local that is git-ignored, or in the deployment platform's own
# secret store.

APP_NAME=Inthes
APP_ENV=local
# Empty here so the entrypoint generates one on first start. For staging or
# production, generate a key once and set it — a key that changes per start
# invalidates every signed file URL and encrypted value already issued.
APP_KEY=
APP_DEBUG=true

# Signed resume / intro-video / document URLs are generated against this, so it
# must match the host the app is actually reached on. A mismatch loads the API
# fine and then 404s every file.
#   USB / adb reverse : http://127.0.0.1:8000
#   phone on same WiFi: http://<your-lan-ip>:8000
APP_URL=http://localhost:8000

APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── database ────────────────────────────────────────────────────────────────
# DB_HOST is the compose service name, set in docker-compose.yml. It is not
# repeated here so running this file outside compose does not silently point
# at a host that does not exist.
DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=jobportal_new
DB_USERNAME=inthes
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Host port for a GUI client. 3307 avoids colliding with Laragon's MySQL.
DB_HOST_PORT=3307

# ── entrypoint behaviour ────────────────────────────────────────────────────
RUN_MIGRATIONS=true
# Demo data (8 jobs, 4 candidates, 2 recruiters). Turn off after the first run
# or the seeder duplicates its rows on every restart.
RUN_SEEDERS=true
# Off in dev so a code edit is picked up without clearing caches by hand.
# Turn on for staging/production.
CACHE_CONFIG=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── dev-only OTP flags ──────────────────────────────────────────────────────
# See API_NOTES.md. NEVER set these in production: together they let anyone
# sign in as any account knowing only the phone number.
OTP_EXPOSE_CODE=false
OTP_DEBUG_CODE=123456
OTP_MAX_SENDS=1000
OTP_SEND_WINDOW_MINUTES=1
OTP_MAX_ATTEMPTS=1000
